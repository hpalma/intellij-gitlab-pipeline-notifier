<idea-plugin>
    <id>org.hugopalma.gitlabpipelinenotifier</id>
    <name>GitLab Pipeline Notifier</name>
    <vendor>Hugo Palma</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <!--
      GitRepositoryManager (git4idea.repo) extends AbstractRepositoryManager, which lives in the
      DVCS module rather than in Git4Idea itself. depending on the Git4Idea plugin does not pull
      module-level classloader visibility into these along with it, so without this block the
      platform fails to link GitRepositoryManager at runtime with
      NoClassDefFoundError: git4idea/repo/GitRepositoryManager, even though it compiles fine
      (build.gradle.kts adds the same modules to the compile classpath via bundledModules(...)).
    -->
    <dependencies>
        <module name="intellij.platform.vcs.dvcs"/>
        <module name="intellij.platform.vcs.dvcs.impl"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!-- STICKY_BALLOON: the balloon stays up until the user dismisses it. -->
        <notificationGroup id="GitLab Pipeline Notifier"
                           displayType="STICKY_BALLOON"
                           isLogByDefault="true"/>

        <applicationConfigurable
                parentId="tools"
                instance="org.hugopalma.gitlabpipelinenotifier.settings.SettingsConfigurable"
                id="org.hugopalma.gitlabpipelinenotifier.settings.SettingsConfigurable"
                displayName="GitLab Pipeline Notifier"/>

        <postStartupActivity
                implementation="org.hugopalma.gitlabpipelinenotifier.startup.PipelineNotifierStartup"/>
    </extensions>
</idea-plugin>
