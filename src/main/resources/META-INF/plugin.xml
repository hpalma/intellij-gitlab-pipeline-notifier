<idea-plugin>
    <id>org.hugopalma.pipelinenotifier</id>
    <name>Pipeline Notifier</name>
    <vendor>Hugo Palma</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- STICKY_BALLOON: the balloon stays up until the user dismisses it. -->
        <notificationGroup id="Pipeline Notifier"
                           displayType="STICKY_BALLOON"
                           isLogByDefault="true"/>

        <applicationConfigurable
                parentId="tools"
                instance="org.hugopalma.pipelinenotifier.settings.SettingsConfigurable"
                id="org.hugopalma.pipelinenotifier.settings.SettingsConfigurable"
                displayName="Pipeline Notifier"/>

        <postStartupActivity
                implementation="org.hugopalma.pipelinenotifier.startup.PipelineNotifierStartup"/>
    </extensions>
</idea-plugin>
